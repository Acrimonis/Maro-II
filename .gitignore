# NO baked data in git. Coastline + depth assets bake into the gitignored /data/app-assets tree and
# package into the APK via the build's asset srcDir; GDAL/OSM intermediates (tiles, .asc) are
# reproducible via tools/fetch_litto3d_paca.ps1 + tools/bake-*.bat. A fresh clone bakes before build.
tools/litto3d_tiles/
/data/

# Raw ASCII grids are too large for GitHub (>100 MB); only committed as pre-baked .bin files.
app/src/main/assets/depth/*.asc
